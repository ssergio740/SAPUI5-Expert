<mvc:View controllerName="project1.SAPUI5.controller.InvoicesList"
xmlns="sap.m"
            xmlns:mvc="sap.ui.core.mvc">
            <List headerText="{i18n>invoiceListTitle}" 
                class="sapUiResponsiveMargin"
                width="auto" 
                items="{invoices>/Invoices}">
                <items>
                    <ObjectListItem title="{invoices>Quantity} x {invoices>ProductName}"
                        number="{ parts: [{path:'invoices>ExtendedPrice'},
                                            {path:'currency>/usd'}]
                                            ,
                                            type: 'sap.ui.model.type.Currency',
                                            formatOptions:{showMeasure : false}
                                            }"
                        numberUnit="{currency>/usd}"
                        numberState="{= ${invoices>ExtendedPrice}>9 ? 'Success' : 'Error'}"
                        
                        />
                </items>
            </List>


</mvc:View>